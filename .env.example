# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Database Configuration
# Fill these with your Supabase Project settings (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Constraint 1: Telemetry Filter Hyperparameters
TELEMETRY_Z_SCORE_THRESHOLD=3.5
TELEMETRY_STUCK_WINDOW=5
TELEMETRY_MAX_DELAY_HORIZON_MS=300000

# Constraint 2: Truth Arbitration Hyperparameters
CONFLICT_STALENESS_HALF_LIFE_SEC=180
CONFLICT_MIN_CONFIDENCE_MARGIN=0.15
CONFLICT_SAFETY_QUARANTINE_ON_AMBIGUITY=true
